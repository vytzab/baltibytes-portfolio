{
  "name": "baltibytes-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run art:validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "art:generate": "node tools/art/generate-placeholders.ts",
    "art:validate": "node tools/art/validate.ts",
    "test": "node --test \"tools/**/*.test.ts\"",
    "check": "tsc --noEmit && npm run art:validate && npm test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
